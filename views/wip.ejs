<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Work In Progress</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/styles/style.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@100..900&family=Zalando+Sans:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <!-- Bee Animation -->
    <style>
        .bee-animation {
            display: block;
            margin: 0 auto;
            width: 120px;
            height: 120px;
            user-select: none;
            pointer-events: none;
        }
    </style>
</head>

<body style="background-color: #1a1a1a;">
    <div class="container text-center" style="padding: 20% 10%; font-family: 'League Spartan', sans-serif;">
        <h1 class="text-center" style="font-weight: 900; font-size: 5rem; color: #facc15;">
            SORRY!
        </h1>
        <h3 class="text-center" style="font-weight: 700; color: #f5f5f5;">
            This page is still a work in progress.
        </h3>
        <button type="button" class="btn btn-warning" onclick="window.location.href='/'" style="margin-top: 20px; font-family: 'Zalando Sans', sans-serif;">
            Back to Home Page
        </button>
        <img src="/content/ubee.png" alt="Bee Animation" class="bee-animation" id="bee">
    </div>
    
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
 
    <!-- Bee Animation Script -->
     <script>
        const bee = document.getElementById("bee");

        //current position
        let x = 0;
        let y = 0;

        //velocity
        let vx = 1;
        let vy = 0;

        //animation parameters
        const maxSpeed = 1.8;
        const turnStrength = 0.04;
        const boundary = 60; // Maximum distance from center

        function animateBee() {

            //random "decision"
            vx += (Math.random() - 0.5) * turnStrength;
            vy += (Math.random() - 0.5) * turnStrength;

            //if it too far, gently steer it back toward the center
            vx += (-x / boundary) * 0.02;
            vy += (-y / boundary) * 0.02;

            //constant flying speed
            const speed = Math.sqrt(vx * vx + vy * vy);
            vx = (vx / speed) * maxSpeed;
            vy = (vy / speed) * maxSpeed;

            //update position
            x += vx;
            y += vy;

            //tilt toward movement direction
            let angle = Math.atan2(vy, vx) * 180 / Math.PI;

            // Clamp the tilt
            angle = Math.max(-25, Math.min(25, angle));

            const hover = Math.sin(Date.now() / 180) * 6;

            bee.style.transform =
                `translate(${x}px, ${y + hover}px) rotate(${angle}deg)`;
                
            requestAnimationFrame(animateBee);
        }

        animateBee();
     </script>
</body>
 </html>