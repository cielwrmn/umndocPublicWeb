<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UMNDOC Crew</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/styles/style.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@100..900&family=Zalando+Sans:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
    <div id="title">
        <h1 class="titleText">Welcome, Crew!</h1>
    </div>
    <div id="login-form">
        <div class="login-container justify-content-center row">
            <div class="col-md-6">
                <h2 class="heading1">Crew Login</h2>
                <form action="/login" method="POST">
                    <label for="username">Username:</label>
                    <input type="text" id="username" name="username" required><br><br>
                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password" required><br><br>
                    <button type="submit">Login</button>
                </form>
            </div>

            <div class="col-md-6">
                <h2 class="heading1">New Crew Member?</h2>
                <button>
                    <a href="https://forms.gle/TUVA744wSvxEpy9Q7">Register Here</a>
                </button>
            </div>
            
        </div>
    </div>
</body>
</html>